# App
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5433/ai_sdlc?schema=public"

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o

# ChromaDB
CHROMA_HOST=http://localhost:8000
CHROMA_COLLECTION_NAME=ai_engineer_knowledge

# RAG Config
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.7

# LLM Config
LLM_TIMEOUT=30000

# Pipeline Tuning
ENRICHER_BATCH_SIZE=5
ENRICHER_TRUNCATE_CHARS=600
AGENT_HISTORY_LIMIT=20
GROUNDING_THRESHOLD=0.3
INSUFFICIENCY_SCORE_THRESHOLD=0.3
INSUFFICIENCY_COVERAGE_THRESHOLD=0.2
